{
  "expo": {
    "name": "Warmer",
    "slug": "warmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14110f",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ashkon.warmer",
      "infoPlist": {
        "NSCameraUsageDescription": "Warmer uses the camera to read the touchscreen in front of you and track your fingertip.",
        "NSMicrophoneUsageDescription": "Warmer listens when you hold the button so you can say what you want.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ashkon.warmer",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#14110f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Warmer listens when you hold the button so you can say what you want."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "18582f2f-09be-4356-b771-688c827c90ff"
      }
    },
    "owner": "warmerr"
  }
}
