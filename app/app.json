{
  "expo": {
    "name": "Warmer",
    "slug": "warmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14110f",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.warmer.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Warmer uses the camera to read the touchscreen in front of you and track your fingertip.",
        "NSMicrophoneUsageDescription": "Warmer listens when you hold the button so you can say what you want.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.warmer.app",
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#14110f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      ["expo-audio", { "microphonePermission": "Warmer listens when you hold the button so you can say what you want." }]
    ]
  }
}
